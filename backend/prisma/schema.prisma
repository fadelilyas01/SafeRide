// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db" // env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password      String
  name          String
  phone         String?
  role          String   @default("RIDER") // RIDER, DRIVER, ADMIN
  isVerified    Boolean  @default(false)
  isWomenSafe   Boolean  @default(false)
  rating        Float    @default(5.0)
  walletBalance Float    @default(0.0)
  fcmToken      String?  // Firebase Cloud Messaging token for push
  stripeCustId  String?  // Stripe Customer ID
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  ridesAsPassenger Ride[]        @relation("PassengerRides")
  ridesAsDriver    Ride[]        @relation("DriverRides")
  transactions     Transaction[]
  chatMessages     ChatMessage[]
}

model Ride {
  id                 String   @id @default(uuid())
  status             String   @default("PENDING") // PENDING, ACCEPTED, ARRIVED, STARTED, COMPLETED, CANCELLED
  pickupLat          Float
  pickupLng          Float
  pickupAddress      String
  destinationLat     Float
  destinationLng     Float
  destinationAddress String
  estimatedPrice     Float
  otp                String
  isWomenSafe        Boolean  @default(false)
  paymentIntentId    String?  // Stripe PaymentIntent ID
  paymentStatus      String   @default("PENDING") // PENDING, PAID, FAILED
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relations
  passengerId  String
  passenger    User          @relation("PassengerRides", fields: [passengerId], references: [id])
  driverId     String?
  driver       User?         @relation("DriverRides", fields: [driverId], references: [id])
  chatMessages ChatMessage[]
}

model Transaction {
  id        String   @id @default(uuid())
  amount    Float
  type      String   // "TOPUP", "SPEND", "REFUND"
  status    String   // "PENDING", "COMPLETED", "FAILED"
  createdAt DateTime @default(now())

  // Relations
  userId String
  user   User   @relation(fields: [userId], references: [id])
}

model ChatMessage {
  id        String   @id @default(uuid())
  text      String
  createdAt DateTime @default(now())

  rideId   String
  ride     Ride   @relation(fields: [rideId], references: [id])
  senderId String
  sender   User   @relation(fields: [senderId], references: [id])
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  target    String
  actor     String
  status    String   @default("Success")
  createdAt DateTime @default(now())
}
