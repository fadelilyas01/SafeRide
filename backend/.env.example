# ============================================================
# SafeRide Backend — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Database (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# JWT Secret (generate a strong random string!)
JWT_SECRET="your-secret-key-here"

# Server port
PORT=3000

# CORS — allowed origins (use your admin dashboard URL in prod)
CORS_ORIGIN="https://admin.saferide.app"

# ====================
# Third-Party Services
# ====================

# Stripe Secret Key (sk_test_...)
STRIPE_SECRET_KEY="sk_test_12345"

# Firebase Admin Service Account JSON (minified single line)
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"saferide-..."}'

# Node environment
NODE_ENV="production"
